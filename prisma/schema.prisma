datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// 1. RBAC & USER MANAGEMENT
// -----------------------------------------------------------------------------

model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  phone                 String?
  password              String
  primaryRole           String                 @default("PENGUNJUNG") // PENGUNJUNG, PETUGAS, ADMIN_TNBTS, OPERATOR_KEUANGAN, SUPER_ADMIN
  isActive              Boolean                @default(true)
  isVerified            Boolean                @default(false)
  riskScore             Int                    @default(0)
  lastLoginAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  visitorProfile        VisitorProfile?
  identityVerifications IdentityVerification[]
  bookings              Booking[]
  notifications         Notification[]
  ticketScans           TicketScan[]           @relation("OfficerScans")
  auditLogs             AuditLog[]
  riskScores            RiskScore[]
  riskEvents            RiskEvent[]
  reviewedRefunds       Refund[]               @relation("RefundReviewer")
  requestedRefunds      Refund[]               @relation("RefundRequester")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique // PENGUNJUNG, PETUGAS, ADMIN_TNBTS, OPERATOR_KEUANGAN, SUPER_ADMIN
  label       String
  description String?
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id        String   @id @default(uuid())
  name      String   @unique
  label     String
  module    String
  roles     Role[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 2. VISITOR PROFILES & IDENTITY
// -----------------------------------------------------------------------------

model VisitorProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName              String
  identityType          String    @default("KTP") // KTP, PASPOR, SIM
  nikOrPassport         String
  citizenship           String    @default("DOMESTIK") // DOMESTIK, MANCANEGARA
  gender                String?   // L, P
  birthDate             DateTime?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  isIdentityVerified    Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([nikOrPassport])
}

model IdentityVerification {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nikOrPassport    String
  idCardPhotoPath  String?
  selfiePhotoPath  String?
  status           String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  notes            String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([nikOrPassport])
  @@index([status])
}

// -----------------------------------------------------------------------------
// 3. DESTINATIONS, SLOTS, & QUOTA ENGINE
// -----------------------------------------------------------------------------

model Destination {
  id                          String      @id @default(uuid())
  name                        String
  code                        String      @unique // PENANJAKAN_1, BUKIT_CINTA, BUKIT_KEDALUH, MENTIGEN, LAUT_PASIR, RANU_KUMBOLO
  slug                        String      @unique
  description                 String?
  locationZone                String      @default("Bromo Tengger")
  coverImageUrl               String?
  dailyCapacity               Int         @default(1000)
  ticketPriceDomesticWeekday  Decimal     @default(29000)
  ticketPriceDomesticWeekend  Decimal     @default(34000)
  ticketPriceForeignWeekday   Decimal     @default(220000)
  ticketPriceForeignWeekend   Decimal     @default(320000)
  insuranceFee                Decimal     @default(5000)
  status                      String      @default("OPEN") // OPEN, LIMITED, CLOSED
  statusNotice                String?
  isActive                    Boolean     @default(true)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  slots                       VisitSlot[]
  quotas                      Quota[]
  bookings                    Booking[]
  tickets                     Ticket[]
}

model VisitSlot {
  id             String      @id @default(uuid())
  destinationId  String
  destination    Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  slotName       String      // Sunrise (03:00-08:00), Daytime (08:00-16:00), Sunset (16:00-19:00)
  startTime      String      // "03:00"
  endTime        String      // "08:00"
  slotCapacity   Int         @default(500)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  quotas         Quota[]
  bookings       Booking[]
  tickets        Ticket[]
}

model Quota {
  id             String       @id @default(uuid())
  destinationId  String
  destination    Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  slotId         String?
  slot           VisitSlot?   @relation(fields: [slotId], references: [id], onDelete: SetNull)
  visitDate      String       // "YYYY-MM-DD"
  totalQuota     Int
  reservedQuota  Int          @default(0)
  paidQuota      Int          @default(0)
  isActive       Boolean      @default(true)
  version        Int          @default(1) // Optimistic concurrency lock counter
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reservations   Reservation[]

  @@unique([destinationId, slotId, visitDate])
  @@index([visitDate])
}

// -----------------------------------------------------------------------------
// 4. BOOKINGS, VISITORS, & RESERVATION CONCURRENCY
// -----------------------------------------------------------------------------

model Booking {
  id                    String           @id @default(uuid())
  bookingCode           String           @unique // e.g. TNBTS-2026-X8F1
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId         String
  destination           Destination      @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  slotId                String?
  slot                  VisitSlot?       @relation(fields: [slotId], references: [id], onDelete: SetNull)
  visitDate             String           // "YYYY-MM-DD"
  totalVisitors         Int              @default(1)
  entranceGate          String           @default("CEMORO_LAWANG") // CEMORO_LAWANG, WONOKITRI, COBAN_TRISULA, SENDURO
  vehicleType           String           @default("JEEP") // JEEP, MOBIL, MOTOR, SEPEDA, JALAN_KAKI
  vehiclePlateNumber    String?
  subtotalTicketAmount  Decimal          @default(0)
  totalInsuranceAmount  Decimal          @default(0)
  totalVehicleFee       Decimal          @default(0)
  totalAmount           Decimal          @default(0)
  status                String           @default("PENDING") // PENDING, RESERVED, PAID, CANCELLED, REFUNDED
  cancellationReason    String?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  visitors              BookingVisitor[]
  reservation           Reservation?
  payment               Payment?
  tickets               Ticket[]
  refund                Refund?

  @@index([status])
  @@index([visitDate])
}

model BookingVisitor {
  id             String    @id @default(uuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fullName       String
  identityType   String    @default("KTP")
  identityNumber String
  citizenship    String    @default("DOMESTIK") // DOMESTIK, MANCANEGARA
  ticketPrice    Decimal   @default(0)
  insuranceFee   Decimal   @default(0)
  totalFee       Decimal   @default(0)
  ticketId       String?
  ticket         Ticket?   @relation("VisitorTicket")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([identityNumber])
}

model Reservation {
  id          String    @id @default(uuid())
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  quotaId     String
  quota       Quota     @relation(fields: [quotaId], references: [id], onDelete: Cascade)
  lockedSlots Int       @default(1)
  sessionId   String
  ipHash      String
  expiresAt   DateTime  // 15 Minutes TTL from creation
  status      String    @default("ACTIVE") // ACTIVE, CONSUMED, EXPIRED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([expiresAt])
  @@index([status])
}

// -----------------------------------------------------------------------------
// 5. PAYMENTS, EVENTS, & REFUNDS
// -----------------------------------------------------------------------------

model Payment {
  id                    String         @id @default(uuid())
  bookingId             String         @unique
  booking               Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider              String         @default("MOCK_SANDBOX") // MIDTRANS, XENDIT, MOCK_SANDBOX
  paymentMethod         String         @default("QRIS") // QRIS, VA_BRI, VA_BCA, VA_MANDIRI, EWALLET
  paymentCode           String?        // VA number or billing ref
  qrString              String?        // QRIS payload
  amount                Decimal
  feeAmount             Decimal        @default(0)
  totalPaid             Decimal        @default(0)
  status                String         @default("PENDING") // PENDING, SETTLED, EXPIRED, FAILED
  externalTransactionId String?
  paidAt                DateTime?
  expiresAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  events                PaymentEvent[]

  @@index([status])
}

model PaymentEvent {
  id             String    @id @default(uuid())
  paymentId      String?
  payment        Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  idempotencyKey String    @unique
  provider       String
  eventType      String
  rawPayload     String
  isProcessed    Boolean   @default(false)
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isProcessed])
}

model Refund {
  id                String    @id @default(uuid())
  bookingId         String    @unique
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedById     String
  requester         User      @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  amount            Decimal
  reason            String
  bankName          String
  bankAccountNumber String
  bankAccountHolder String
  status            String    @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, PROCESSED
  reviewedById      String?
  reviewer          User?     @relation("RefundReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewNotes       String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
}

// -----------------------------------------------------------------------------
// 6. TICKETS & DYNAMIC TIME-ROLLING TOKEN
// -----------------------------------------------------------------------------

model Ticket {
  id               String          @id @default(uuid())
  ticketCode       String          @unique // e.g. TKT-2026-X89A
  bookingId        String
  booking          Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingVisitorId String          @unique
  visitor          BookingVisitor  @relation("VisitorTicket", fields: [bookingVisitorId], references: [id], onDelete: Cascade)
  destinationId    String
  destination      Destination     @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  slotId           String?
  slot             VisitSlot?      @relation(fields: [slotId], references: [id], onDelete: SetNull)
  visitDate        String          // "YYYY-MM-DD"
  visitorName      String
  identityNumber   String
  entranceGate     String          @default("CEMORO_LAWANG")
  status           String          @default("ISSUED") // ISSUED, USED, CANCELLED, EXPIRED, INVALID
  secretTokenSalt  String          // HMAC rolling token salt
  usedAt           DateTime?
  issuedAt         DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  scans            TicketScan[]

  @@index([status])
  @@index([visitDate])
  @@index([identityNumber])
}

model TicketScan {
  id               String    @id @default(uuid())
  ticketId         String
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  scannedByUserId  String
  officer          User      @relation("OfficerScans", fields: [scannedByUserId], references: [id], onDelete: Cascade)
  gateLocation     String    // CEMORO_LAWANG, WONOKITRI, COBAN_TRISULA, SENDURO
  scanResult       String    // VALID, ALREADY_USED, EXPIRED, INVALID_SIGNATURE, WRONG_DATE, BLOCKED
  responseMessage  String?
  isOfflineSync    Boolean   @default(false)
  deviceInfo       String?
  scannedAt        DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([scanResult])
  @@index([scannedAt])
}

// -----------------------------------------------------------------------------
// 7. ANTI-ABUSE & BEHAVIORAL RISK ENGINE
// -----------------------------------------------------------------------------

model RiskScore {
  id               String      @id @default(uuid())
  userId           String?
  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipHash           String
  sessionId        String
  score            Int         @default(0) // 0-100
  riskLevel        String      @default("LOW") // LOW, MEDIUM, HIGH
  evaluatedSignals String?     // JSON string
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  events           RiskEvent[]

  @@index([ipHash])
  @@index([sessionId])
  @@index([riskLevel])
}

model RiskEvent {
  id             String     @id @default(uuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  riskScoreId    String?
  riskScore      RiskScore? @relation(fields: [riskScoreId], references: [id], onDelete: SetNull)
  actionType     String     // RAPID_SUBMISSION, CONCURRENT_SESSION, FAKE_NIK_PATTERN, BOT_AGENT
  ipHash         String
  sessionId      String
  severity       String     @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  reason         String?
  payloadSummary String?    // JSON string
  actionTaken    String     @default("ALLOW") // ALLOW, CHALLENGE, THROTTLE, BLOCKED
  status         String     @default("OPEN") // OPEN, REVIEWED, FALSE_POSITIVE, RESOLVED
  reviewNotes    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([actionType])
  @@index([status])
}

// -----------------------------------------------------------------------------
// 8. NOTIFICATIONS, AUDIT LOGS, & SYSTEM SETTINGS
// -----------------------------------------------------------------------------

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    @default("SYSTEM") // BOOKING_CREATED, PAYMENT_SUCCESS, TICKET_ISSUED, ANNOUNCEMENT
  actionUrl String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String?
  action     String   // AUTH_LOGIN, QUOTA_UPDATE, BOOKING_RESERVED, TICKET_SCANNED, REFUND_PROCESSED
  entityType String?  // Destination, Quota, Booking, Ticket, etc.
  entityId   String?
  oldValues  String?  // JSON string
  newValues  String?  // JSON string
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) // Immutable append-only

  @@index([action])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String?
  type        String   @default("string") // string, integer, boolean, json
  group       String   @default("general") // booking, anti_abuse, quota, payment, gate
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
